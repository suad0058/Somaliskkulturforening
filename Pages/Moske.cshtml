@page
@model Moske
@{
    ViewData["Title"] = "Moské";
}

<section class="moske-section">
    <div class="container">
        <p class="section-label">Byggeprojekt</p>
        <h2 class="section-title">Vores nye moské</h2>

        <div class="moske-hero">
            <h3>Hjælp os med at bygge et hus for vores fællesskab</h3>
            <p>Vi er i gang med at realisere drømmen om en moské, der kan rumme hele vores menighed. Projektet er finansieret udelukkende af fællesskabets bidrag.</p>

            <div class="progress-section">
                <div class="progress-label">
                    <span>Indsamlet så langt</span>
                    <strong>423.500 kr af 1.500.000 kr</strong>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: 28%"></div>
                </div>
            </div>

            <div class="moske-stats">
                <div class="moske-stat">
                    <div class="num">287</div>
                    <div class="lbl">Bidragydere</div>
                </div>
                <div class="moske-stat">
                    <div class="num">2026</div>
                    <div class="lbl">Målår</div>
                </div>
                <div class="moske-stat">
                    <div class="num">500m²</div>
                    <div class="lbl">Planlagt areal</div>
                </div>
            </div>
        </div>

        <div class="moske-updates">
            <h3>Seneste nyt fra projektet</h3>
            <div class="update-item">
                <div class="update-dot"></div>
                <div>
                    <h4>Grundkøb godkendt af bestyrelsen</h4>
                    <p>Efter måneder med forhandlinger er der nu indgået aftale om køb af grund.</p>
                    <div class="update-date">Marts 2026</div>
                </div>
            </div>
            <div class="update-item">
                <div class="update-dot"></div>
                <div>
                    <h4>Arkitekttegninger præsenteret</h4>
                    <p>Første udkast til moskéens design er præsenteret for menigheden.</p>
                    <div class="update-date">Januar 2026</div>
                </div>
            </div>
            <div class="update-item">
                <div class="update-dot"></div>
                <div>
                    <h4>Fundraiser afholdt – stor succes</h4>
                    <p>Vores fundraiser-middag indbragte over 80.000 kr til byggefonden.</p>
                    <div class="update-date">December 2025</div>
                </div>
            </div>
        </div>
    </div>
</section>