@page
@model Sadaqah
@{
    ViewData["Title"] = "Sadaqah";
}

<section class="sadaqah-section">
    <div class="container">
        <p class="section-label">Donationer</p>
        <h2 class="section-title">Sadaqah – giv af dit bedste</h2>

        <div class="sadaqah-grid">
            <div class="sadaqah-text">
                <p class="sadaqah-desc">Sadaqah er en af islams smukkeste handlinger – at give frivilligt for Allahs skyld. Dine bidrag går direkte til foreningens aktiviteter, støtte til trængende familier og byggefonden til vores moské.</p>

                <div class="bank-info">
                    <h4>Bankoverførsel</h4>
                    <div class="bank-row">
                        <span class="lbl">Bank</span>
                        <span class="val">Indsæt banknavn</span>
                    </div>
                    <div class="bank-row">
                        <span class="lbl">Reg. nr.</span>
                        <span class="val">XXXX</span>
                    </div>
                    <div class="bank-row">
                        <span class="lbl">Konto nr.</span>
                        <span class="val">XXXXXXXXXX</span>
                    </div>
                    <div class="bank-row">
                        <span class="lbl">MobilePay</span>
                        <span class="val">#XXXXX</span>
                    </div>
                </div>
            </div>

            <div class="hadith-card">
                <blockquote>"Den der giver sadaqah, ser sin formue ikke mindsket."</blockquote>
                <cite>— Sahih Muslim</cite>
            </div>
        </div>
    </div>
</section>