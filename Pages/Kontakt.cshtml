@page
@model Kontakt
@{
    ViewData["Title"] = "Kontakt";
}

<section class="kontakt-section">
    <div class="container">
        <p class="section-label">Skriv til os</p>
        <h2 class="section-title">Kontakt foreningen</h2>

        <div class="kontakt-grid">
            <div class="kontakt-info">
                <div class="contact-item">
                    <div class="contact-icon">📍</div>
                    <div>
                        <h4>Adresse</h4>
                        <p>Egeparken 56, 5240 Odense NØ</p>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon">📞</div>
                    <div>
                        <h4>Telefon</h4>
                        <p>+45 71 44 74 27</p>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon">✉️</div>
                    <div>
                        <h4>E-mail</h4>
                        <p>Suad12@live.dk</p>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon">🕐</div>
                    <div>
                        <h4>Åbningstider</h4>
                        <p>Mandag–Fredag: 16–20<br/>Weekend: 10–18</p>
                    </div>
                </div>
            </div>

            <div class="contact-form">
                <div class="form-group">
                    <label>Navn</label>
                    <input type="text" placeholder="Dit navn"/>
                </div>
                <div class="form-group">
                    <label>E-mail</label>
                    <input type="email" placeholder="din@@email.dk"/>
                </div>
                <div class="form-group">
                    <label>Besked</label>
                    <textarea placeholder="Skriv din besked her..."></textarea>
                </div>
                <button class="btn-submit">Send besked →</button>
            </div>
        </div>
    </div>
</section>